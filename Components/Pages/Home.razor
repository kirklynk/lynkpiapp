@page "/"

@inject HardwareService HardwareService

<PageTitle>Home</PageTitle>

<MudGrid>
    <MudItem>
        <MudStack>
            <MudButton Variant="Variant.Filled" OnClick="ButtonClicked">
                ARM AWAY
            </MudButton>
            <MudButton Variant="Variant.Filled" OnClick="ButtonClicked">
                ARM HOME
            </MudButton>
            <MudButton Variant="Variant.Filled" OnClick="ButtonClicked">
                DISARM
            </MudButton>
        </MudStack>
    </MudItem>
    <MudItem>
        @HardwareService.Clock.ToString("hh:mm:ss tt")

<p>@HardwareService.IsTriggered</p>
    </MudItem>
</MudGrid>
@code {

    protected override void OnInitialized()
    {
        HardwareService.PropertyChanged += (sender, args) =>
        {
            InvokeAsync(StateHasChanged);

        };
        base.OnInitialized();
    }

    void ButtonClicked(MouseEventArgs args)
    {
        Console.WriteLine($"Button clicked at {DateTime.Now}");
    }

}