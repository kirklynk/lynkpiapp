@inherits LayoutComponentBase
@inject HardwareService _hardwareService

<MudLayout>
    <MudAppBar Elevation="1" Gutters="true" Color="@Color">

        <MudSpacer />
        <MudText Class="ml-3">@_hardwareService.Clock.ToLongDateString()</MudText>
        <MudSpacer />
        <MudSwitch T="bool" @bind-Value="@IsDarkMode" Label="Dark Mode" />
    </MudAppBar>
    <MudMainContent>
        <div class="@(_hardwareService.IsTriggered ? "animated-border animated-background" : "border")">
            @Body
            <div id="blazor-error-ui" data-nosnippet>
                An unhandled error has occurred.
                <a href="." class="reload">Reload</a>
                <span class="dismiss">🗙</span>
            </div>
        </div>
    </MudMainContent>
</MudLayout>


<MudThemeProvider IsDarkMode="IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@code {

    public bool IsDarkMode { get; set; } = true;
    protected override void OnInitialized()
    {
        base.OnInitialized();
        _hardwareService.PropertyChanged += (sender, args) =>
        {
            InvokeAsync(StateHasChanged);
        };
    }

    Color Color => _hardwareService.CurrentState != AlarmState.Disarm ? Color.Error : Color.Default;

}
