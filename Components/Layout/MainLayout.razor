@inherits LayoutComponentBase
@inject HardwareService _hardwareService
@inject ILogger<MainLayout> _logger
@inject IHttpClientFactory _clientFactory

@if (!_showScreenSaver || _hardwareService.IsTriggered)
{
    <MudLayout>
        <MudAppBar Elevation="1" Gutters="true" Color="@Color">

            <MudSpacer />
            <MudText Class="ml-3">@_hardwareService.Clock.ToLongDateString()</MudText>
            <MudSpacer />
            <MudSwitch T="bool" @bind-Value="@_isDarkMode" Label="Dark Mode" />
        </MudAppBar>
        <MudMainContent>
            <div class="@(_hardwareService.IsTriggered ? "animated-border animated-background" : "border")">
                @Body
                <div id="blazor-error-ui" data-nosnippet>
                    An unhandled error has occurred.
                    <a href="." class="reload">Reload</a>
                    <span class="dismiss">🗙</span>
                </div>
            </div>
        </MudMainContent>
    </MudLayout>
}
else
{
    <ScreenSaver  />
}

<MudThemeProvider IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@code {

    private IJSObjectReference _module;
    private DotNetObjectReference<MainLayout> _dotNetObjectReference;
    private bool _isDarkMode = true;
    private bool _showScreenSaver = false;
    

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _dotNetObjectReference = DotNetObjectReference.Create(this);

        _hardwareService.PropertyChanged += (sender, args) =>
        {
            InvokeAsync(StateHasChanged);
        };
    }

    Color Color => _hardwareService.CurrentState != AlarmState.Disarm ? Color.Error : Color.Default;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            _module = await _js.InvokeAsync<IJSObjectReference>("import", "./js/screensaver.js");
            await _module.InvokeVoidAsync("init", _dotNetObjectReference);
           
        }
    }

    [JSInvokable("toggleScreenSaver")]
    public async Task ToggleScreenSaver()
    {
        _logger.LogInformation("Logging touch event");
        _showScreenSaver = !_showScreenSaver;
    }   
}
