@inherits LayoutComponentBase
@inject HardwareService _hardwareService

<MudLayout>
    <MudAppBar Elevation="1" Color="@Color" Gutters="true">
       
        <MudSpacer />
        <MudText Class="ml-3">@_hardwareService.Clock.ToLongDateString()</MudText>
        <MudSpacer />
        <MudSwitch T="bool" @bind-Value="@IsDarkMode" Label="Dark Mode" />
    </MudAppBar>
    <MudMainContent>
        @Body
        <div id="blazor-error-ui" data-nosnippet>
            An unhandled error has occurred.
            <a href="." class="reload">Reload</a>
            <span class="dismiss">🗙</span>
        </div>
       
    </MudMainContent>
</MudLayout>


<MudThemeProvider IsDarkMode="IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@code {

    public Color Color
    {
        get
        {
            return _hardwareService.AlarmState switch
            {
                AlarmState.ArmedAway => Color.Error,
                AlarmState.ArmedHome => Color.Warning,
                AlarmState.Disarm => Color.Success,
                _ => Color.Default
            };
        }
    }

    public bool IsDarkMode { get; set; } = false;
    protected override void OnInitialized()
    {
        base.OnInitialized();
        _hardwareService.PropertyChanged += (sender, args) =>
        {
            InvokeAsync(StateHasChanged);
        };
    }

}