@inherits LayoutComponentBase
@inject HardwareService _hardwareService

<MudLayout>
    <MudAppBar Elevation="1" Color="@Color">
        <MudText Typo="Typo.h5" Class="ml-3">Lynk Alarm System</MudText>

    </MudAppBar>
    <MudMainContent Style="margin: 0.4rem;">
        @Body
        <div id="blazor-error-ui" data-nosnippet>
            An unhandled error has occurred.
            <a href="." class="reload">Reload</a>
            <span class="dismiss">🗙</span>
        </div>
    </MudMainContent>
</MudLayout>


@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

@code {

    public Color Color
    {
        get
        {
            return _hardwareService.AlarmState switch
            {
                AlarmState.ArmedAway => Color.Error,
                AlarmState.ArmedHome => Color.Warning,
                AlarmState.Disarm => Color.Success,
                _ => Color.Default
            };
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _hardwareService.PropertyChanged += (sender, args) =>
        {
            InvokeAsync(StateHasChanged);
        };
    }

}