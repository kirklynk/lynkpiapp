@inject HardwareService _hardwareService

<p style="margin: 0 1rem 1rem 1rem">
    <MudGrid>
        <MudItem xs="12" lg="12" md="12" sm="12">
            <MudDataGrid T="(string desc, int pin, bool tripped)" Items="_hardwareService.Tripped" SortMode="SortMode.None">
                <Columns>
                    <PropertyColumn Property="x => x.desc" Title="" />
                </Columns>
            </MudDataGrid>
        </MudItem>

        <MudItem xs="4" lg="4" md="4" sm="4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="keypad-button-0" Style="width: 100%;" OnClick="() => DialogReference?.CancelAll()">Cancel</MudButton>
        </MudItem>
        <MudItem xs="4" lg="4" md="4" sm="4">

        </MudItem>
        <MudItem xs="4" lg="4" md="4" sm="4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="keypad-button-0" Style="width: 100%;" OnClick="() => DialogReference?.Close(DialogResult.Ok(AlarmState.Disarm))">Disarm</MudButton>
        </MudItem>
    </MudGrid>
</p>

@code {

    [CascadingParameter]
    private IMudDialogInstance? DialogReference { get; set; }
}
