
<p style="margin: 0 1rem 1rem 1rem">
    <MudDataGrid T="string" Items="OpenSensors" SortMode="SortMode.None">
        <Columns>
            <PropertyColumn Property="x => x" Title="" />
        </Columns>
    </MudDataGrid>
    <div style="text-align: center; margin-top: 1rem;">
        <MudStack Justify="Justify.SpaceBetween">
            @if (ShowBypassButton)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Dialog?.Close(DialogResult.Ok(true)))">BYPASS</MudButton>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Dialog?.CancelAll())">CANCEL</MudButton>

        </MudStack>
    </div>
</p>

@code {

    [CascadingParameter]
    public IMudDialogInstance Dialog { get; set; }

    [Parameter]
    public List<string> OpenSensors { get; set; } = [];

    [Parameter]
    public bool ShowBypassButton { get; set; } = false;
}
