<h5>Open sensors</h5>
<div style="margin: 1rem;">
    <MudDataGrid T="string" Items="OpenSensors" SortMode="SortMode.None">
        <Columns>
            <PropertyColumn Property="x => x" Title="" />
        </Columns>

    </MudDataGrid>
    <p style="text-align: center; margin-top: 1rem;">

        <MudButton Variant="Variant.Filled" OnClick="@(() => Dialog?.CancelAll())">CLOSE</MudButton>

    </p>
</div>

@code {

    [CascadingParameter]
    public IMudDialogInstance Dialog { get; set; }

    [Parameter]
    public List<string> OpenSensors { get; set; }
}
